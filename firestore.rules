rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && ('admin' in request.auth.token)
        && request.auth.token.admin == true
        && request.auth.token.email_verified == true;
    }

    function ownsPatient(patientId) {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.patientId == patientId
        && get(/databases/$(database)/documents/patients/$(patientId)).data.linkedUid == request.auth.uid
        && get(/databases/$(database)/documents/patients/$(patientId)).data.accountStatus == 'linked'
        && (!('portalAccessStatus' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data)
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.portalAccessStatus == 'enabled')
        && (!('portalAccessStatus' in get(/databases/$(database)/documents/patients/$(patientId)).data)
          || get(/databases/$(database)/documents/patients/$(patientId)).data.portalAccessStatus == 'enabled');
    }

    function canReadPatient(patientId) {
      return isAdmin() || ownsPatient(patientId);
    }

    function validDailyLogMeals() {
      return !('meals' in request.resource.data)
        || (
          request.resource.data.meals is map
          && request.resource.data.meals.keys().hasOnly([
            'breakfast', 'lunch', 'dinner', 'snacks'
          ])
          && request.resource.data.meals.keys().hasAll([
            'breakfast', 'lunch', 'dinner'
          ])
          && request.resource.data.meals.breakfast is bool
          && request.resource.data.meals.lunch is bool
          && request.resource.data.meals.dinner is bool
          && (!('snacks' in request.resource.data.meals)
            || request.resource.data.meals.snacks is bool)
        );
    }

    function validDailyLog() {
      return request.resource.data.keys().hasAll([
          'dateKey', 'proteinGrams', 'waterMl', 'electrolytesTaken', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'dateKey', 'proteinGrams', 'waterMl', 'electrolytesTaken',
          'createdAt', 'meals', 'activityMinutes'
        ])
        && request.resource.data.dateKey is string
        && request.resource.data.dateKey.matches('^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]$')
        && request.resource.data.proteinGrams is number
        && request.resource.data.proteinGrams >= 0
        && request.resource.data.proteinGrams <= 300
        && request.resource.data.waterMl is number
        && request.resource.data.waterMl >= 0
        && request.resource.data.waterMl <= 7000
        && request.resource.data.electrolytesTaken is bool
        && validDailyLogMeals()
        && (!('activityMinutes' in request.resource.data)
          || (request.resource.data.activityMinutes is int
            && request.resource.data.activityMinutes >= 0
            && request.resource.data.activityMinutes <= 1440))
        && request.resource.data.createdAt == request.time;
    }

    function validSymptomReport() {
      return request.resource.data.keys().hasAll([
          'symptom', 'severity', 'durationMinutes', 'notes', 'occurredAt', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'symptom', 'severity', 'durationMinutes', 'notes', 'occurredAt', 'createdAt'
        ])
        && request.resource.data.symptom is string
        && request.resource.data.symptom in [
          'nausea', 'vomiting', 'abdominal_pain', 'diarrhea', 'reflux',
          'bloating', 'headache', 'dizziness', 'fatigue', 'constipation'
        ]
        && request.resource.data.severity is int
        && request.resource.data.severity >= 1
        && request.resource.data.severity <= 5
        && request.resource.data.durationMinutes is int
        && request.resource.data.durationMinutes >= 0
        && request.resource.data.durationMinutes <= 10080
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 1000
        && request.resource.data.occurredAt is timestamp
        && request.resource.data.createdAt == request.time;
    }

    function validPrescriptionRequest() {
      return request.resource.data.keys().hasAll([
          'category', 'requestedProduct', 'message', 'status', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'category', 'requestedProduct', 'message', 'status', 'createdAt'
        ])
        && request.resource.data.category is string
        && request.resource.data.category.size() <= 80
        && request.resource.data.requestedProduct is string
        && request.resource.data.requestedProduct.size() <= 160
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 500
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
    }

    // User-to-patient mapping is provisioned by trusted server code only.
    // A patient can read their own mapping but cannot assign their own patientId or role.
    match /users/{uid} {
      allow get: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // The parent document contains only patient-visible demographic/profile fields.
    // Keep doctor-only notes and internal audit records in restricted subcollections.
    match /patients/{patientId} {
      allow get: if canReadPatient(patientId);
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();

      match /measurements/{measurementId} {
        allow read: if canReadPatient(patientId);
        allow write: if isAdmin();
      }

      match /treatmentEvents/{eventId} {
        allow read: if canReadPatient(patientId);
        allow write: if isAdmin();
      }

      match /nutritionPlans/{planId} {
        allow read: if canReadPatient(patientId);
        allow write: if isAdmin();
      }

      match /prescriptions/{prescriptionId} {
        allow read: if canReadPatient(patientId);
        allow write: if isAdmin();
      }

      // Patients may append their own daily check-ins. They cannot edit or erase
      // previously submitted clinical records.
      match /dailyLogs/{logId} {
        allow read: if canReadPatient(patientId);
        allow create: if ownsPatient(patientId) && validDailyLog() && logId == request.resource.data.dateKey;
        allow update, delete: if isAdmin();
      }

      // Symptom reports are append-only for the patient and visible to the doctor.
      match /symptomReports/{reportId} {
        allow read: if canReadPatient(patientId);
        allow create: if ownsPatient(patientId) && validSymptomReport();
        allow update, delete: if isAdmin();
      }

      // Patient-originated requests may be created only for the authenticated
      // patient's own record and must always start in pending status.
      match /prescriptionRequests/{requestId} {
        allow read: if canReadPatient(patientId);
        allow create: if ownsPatient(patientId) && validPrescriptionRequest();
        allow update, delete: if isAdmin();
      }

      // Internal clinical notes and audit records are never visible to patients.
      match /doctorNotes/{noteId} {
        allow read, write: if isAdmin();
      }

      match /auditLogs/{eventId} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }

    // Isolated Preview namespace. This mirrors the production data model while
    // keeping Preview users and patient records separate from root collections.
    function ownsPreviewPatient(environmentId, patientId) {
      return signedIn()
        && get(/databases/$(database)/documents/previewEnvironments/$(environmentId)/users/$(request.auth.uid)).data.patientId == patientId
        && get(/databases/$(database)/documents/previewEnvironments/$(environmentId)/patients/$(patientId)).data.linkedUid == request.auth.uid
        && get(/databases/$(database)/documents/previewEnvironments/$(environmentId)/patients/$(patientId)).data.accountStatus == 'linked'
        && (!('portalAccessStatus' in get(/databases/$(database)/documents/previewEnvironments/$(environmentId)/users/$(request.auth.uid)).data)
          || get(/databases/$(database)/documents/previewEnvironments/$(environmentId)/users/$(request.auth.uid)).data.portalAccessStatus == 'enabled')
        && (!('portalAccessStatus' in get(/databases/$(database)/documents/previewEnvironments/$(environmentId)/patients/$(patientId)).data)
          || get(/databases/$(database)/documents/previewEnvironments/$(environmentId)/patients/$(patientId)).data.portalAccessStatus == 'enabled');
    }

    function canReadPreviewPatient(environmentId, patientId) {
      return isAdmin() || ownsPreviewPatient(environmentId, patientId);
    }

    match /previewEnvironments/{environmentId}/users/{uid} {
      allow get: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /previewEnvironments/{environmentId}/invitations/{invitationId} {
      allow read, write: if isAdmin();
    }

    match /previewEnvironments/{environmentId}/patients/{patientId} {
      allow get: if canReadPreviewPatient(environmentId, patientId);
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();

      match /measurements/{measurementId} {
        allow read: if canReadPreviewPatient(environmentId, patientId);
        allow write: if isAdmin();
      }
      match /treatmentEvents/{eventId} {
        allow read: if canReadPreviewPatient(environmentId, patientId);
        allow write: if isAdmin();
      }
      match /nutritionPlans/{planId} {
        allow read: if canReadPreviewPatient(environmentId, patientId);
        allow write: if isAdmin();
      }
      match /prescriptions/{prescriptionId} {
        allow read: if canReadPreviewPatient(environmentId, patientId);
        allow write: if isAdmin();
      }
      match /dailyLogs/{logId} {
        allow read: if canReadPreviewPatient(environmentId, patientId);
        allow create: if ownsPreviewPatient(environmentId, patientId) && validDailyLog() && logId == request.resource.data.dateKey;
        allow update, delete: if isAdmin();
      }
      match /symptomReports/{reportId} {
        allow read: if canReadPreviewPatient(environmentId, patientId);
        allow create: if ownsPreviewPatient(environmentId, patientId) && validSymptomReport();
        allow update, delete: if isAdmin();
      }
      match /prescriptionRequests/{requestId} {
        allow read: if canReadPreviewPatient(environmentId, patientId);
        allow create: if ownsPreviewPatient(environmentId, patientId) && validPrescriptionRequest();
        allow update, delete: if isAdmin();
      }
      match /doctorNotes/{noteId} {
        allow read, write: if isAdmin();
      }
      match /auditLogs/{eventId} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }

    // Private clinic settings: payment details, internal contact settings and
    // operational configuration must never be available to unauthenticated visitors.
    match /clinicSettings/{documentId} {
      allow read, write: if isAdmin();
    }

    // Only explicitly curated, non-sensitive content is public.
    match /publicContent/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Public leads must be submitted through a validated server endpoint,
    // not directly from the anonymous browser client.
    match /intakeLeads/{leadId} {
      allow read, write: if isAdmin();
    }

    // Prescription request and clinical paths from the old monolithic document
    // are intentionally denied until the data migration is complete.
    match /artifacts/{document=**} {
      allow read, write: if false;
    }

    // Deny every path not explicitly declared above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
